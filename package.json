{
  "name": "dj-hq",
  "productName": "DJ HQ",
  "version": "0.1.0",
  "description": "Local playlist reconciliation, rekordbox tagging and player-compat conversion for DJs",
  "main": "dist/main.js",
  "license": "MIT",
  "author": "Jan Bany",
  "scripts": {
    "build": "tsc",
    "start": "npm run build && electron .",
    "headless": "npm run build && node dist/server.js",
    "dist": "npm run build && electron-builder"
  },
  "build": {
    "appId": "com.djhq.app",
    "productName": "DJ HQ",
    "files": [
      "dist/**",
      "web/**",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "node_modules/ffprobe-static/**"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.music"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    }
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "electron": "^43.3.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0"
  }
}
