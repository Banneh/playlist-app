{
  "name": "dj-hq",
  "productName": "DJ HQ",
  "version": "1.4.0",
  "description": "Local playlist reconciliation, rekordbox tagging and player-compat conversion for DJs",
  "main": "dist/main.js",
  "license": "MIT",
  "author": "Jan Bany",
  "repository": {
    "type": "git",
    "url": "https://github.com/Banneh/playlist-app.git"
  },
  "scripts": {
    "build": "tsc",
    "start": "npm run build && electron .",
    "headless": "npm run build && node dist/server.js",
    "dist": "npm run build && electron-builder",
    "screens": "npm run build && electron scripts/screenshots.js"
  },
  "build": {
    "appId": "com.djhq.app",
    "publish": {
      "provider": "github",
      "owner": "Banneh",
      "repo": "playlist-app",
      "releaseType": "release",
      "publishAutoUpdate": false
    },
    "directories": {
      "output": "release"
    },
    "productName": "DJ HQ",
    "files": [
      "dist/**",
      "web/**",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "node_modules/ffprobe-static/**"
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.music",
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}",
      "identity": null
    },
    "dmg": {
      "writeUpdateInfo": false
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "differentialPackage": false
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    },
    "afterPack": "scripts/afterPack.js"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0"
  }
}
